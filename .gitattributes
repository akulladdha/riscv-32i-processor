* text=auto eol=lf

# ---- Explicit text types (HDL, constraints, scripts, docs) ----
*.v      text eol=lf
*.sv     text eol=lf
*.svh    text eol=lf
*.vh     text eol=lf
*.xdc    text eol=lf
*.tcl    text eol=lf
*.hex    text eol=lf
*.md     text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# ---- Binary: never diff, never munge line endings ----
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.bit    binary
*.bin    binary
*.mcs    binary
*.vcd    binary
*.fst    binary
*.vvp    binary
